{
  "name": "dsh-game-creator",
  "version": "1.0.0",
  "description": "「游戏制作模式」— a DeepSeek Harness agent preset that builds Godot 4.7 games through the Godot AI MCP bridge, and can scaffold or open Godot projects.",
  "type": "module",
